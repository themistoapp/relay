# Password for the admin UI (port 8080). At least 8 characters.
ADMIN_PASSWORD=change-me-please
# Encrypts the upstream API tokens stored in the database, and signs the admin session cookie.
# At least 16 characters. BACK THIS UP: if it's lost, stored tokens can't be decrypted and
# have to be re-entered. Generate one with: openssl rand -base64 32
APP_SECRET=
# Where re-served endpoints are reachable from outside, e.g. https://api.example.com (used to show
# full URLs in the UI). Leave empty to use the admin UI's host with PUBLIC_HOST_PORT.
PUBLIC_BASE_URL=
TZ=Europe/London
# Optional: POSTed JSON when a source fails this many pulls in a row (and again when it recovers).
# ALERT_WEBHOOK_URL=https://ntfy.sh/your-topic
# ALERT_AFTER_FAILURES=3
